# GateKeeper configuration.
#
# Copy to .env and fill in the two required values. Everything else has a
# working default, and most of it can be changed later in the admin UI without
# a restart. Values set here act as the starting point on first run; once a
# setting is saved in the admin UI, that saved value wins.
#
# Full reference: https://gatekeeper.xyzlab.dev/reference/env-vars

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public URL of the sign-in server. Used as the OIDC issuer, the passkey
# origin, and in the links inside emails. No trailing slash.
BASE_URL=https://auth.example.com

# Minimum 32 characters. Signs sessions and encrypts TOTP secrets, stored
# credentials, and backups. Generate one with: openssl rand -hex 32
# Changing it after first run invalidates every session and makes existing
# backups undecryptable.
SECRET_KEY=

# ---------------------------------------------------------------------------
# Ports and addresses
# ---------------------------------------------------------------------------

# Public port: sign-in, OIDC, and ForwardAuth.
PORT=8282

# Admin panel port, served at the root of that port. Keep it off the public
# internet and route it only through a private reverse proxy.
ADMIN_PORT=8283

# Public URL of the admin panel when it runs on its own subdomain. Set this so
# admin passkeys work. Must sit under the same registrable domain as BASE_URL.
ADMIN_URL=https://admin.auth.example.com

# Serve the admin under a path prefix instead of the root. Leave empty when the
# admin has its own domain. Set to /admin only if your proxy routes the admin
# port under a /admin subpath without stripping the prefix.
ADMIN_BASE_PATH=

# SQLite database path. Mount a volume at /data so it survives restarts.
DB_PATH=/data/gatekeeper.db

# ---------------------------------------------------------------------------
# Sessions and redirects
# ---------------------------------------------------------------------------

# Share the session cookie across subdomains, for example .example.com.
# Leave empty when every app is on the same host.
COOKIE_DOMAIN=

# Where a user may be sent after signing in, for ForwardAuth apps outside
# COOKIE_DOMAIN. Comma-separated. Each entry covers that domain and all of its
# subdomains, so example.net allows app.example.net. Your own BASE_URL and
# ADMIN_URL hosts are always allowed. Also settable in the admin UI under
# Settings, Access control, Protected app domains.
REDIRECT_ALLOWED_HOSTS=

# Session lifetime in hours. Resets on every request, so active users stay
# signed in. Overridable in the admin UI.
SESSION_TTL_HOURS=8

# ---------------------------------------------------------------------------
# Mail
#
# Needed to send one-time sign-in codes and password reset emails. All of these
# are overridable in the admin UI, which also has a "send test" button.
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# starttls, tls, or none
SMTP_TLS=starttls

# ---------------------------------------------------------------------------
# Accounts and registration
#
# Overridable in the admin UI.
# ---------------------------------------------------------------------------

# Restrict which email domains may sign in. Comma-separated.
# Leave empty to allow any address.
ALLOWED_EMAIL_DOMAINS=

# disabled, invite_only, open, or approval
REGISTRATION_MODE=disabled

# Restrict which email domains may self-register. Comma-separated.
# Leave empty to allow any domain. Applies to open and approval modes.
REGISTRATION_ALLOWED_DOMAINS=

# ---------------------------------------------------------------------------
# Social sign-in
#
# Seeded into the admin UI on first startup, and editable there afterwards.
# Leave a pair blank to keep that provider switched off. Redirect URI to
# register with each provider is BASE_URL + /auth/social/<provider>/callback
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug, info, warn, or error. Use debug to troubleshoot ForwardAuth, which
# logs the forwarded host and the redirect it builds.
LOG_LEVEL=info
